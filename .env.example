# ==============================================================================
# Rust Sped Analytics - Variáveis de Ambiente
# ==============================================================================

# Ambiente de execução: development ou production
ENVIRONMENT=development

# Segredo de autenticação JWT (deve possuir ao menos 32 caracteres em produção)
JWT_SECRET=ecd_analytics_production_jwt_secret_token_key_2026_super_strong_random_seed_ok

# Chave interna para autenticação entre serviços
ECD_BACKEND_API_KEY=ecd_internal_secret_token_change_in_production

# Portas dos serviços
PORT=8080
AI_GATEWAY_PORT=8005
WEB_PORT=3000
POSTGRES_PORT=5435
REDIS_PORT=6385

# Conexões de banco e cache (para uso via docker-compose na rede interna)
DATABASE_URL=postgres://ecd_user:ecd_password@postgres:5432/ecd_db
REDIS_URL=redis://redis:6379

# Credenciais PostgreSQL do container
POSTGRES_USER=ecd_user
POSTGRES_PASSWORD=ecd_password
POSTGRES_DB=ecd_db

# Diretório de staging e bases locais
ECD_STAGE_DIR=./media/ecd_stage
TURMALINA_BASES_PATH=/apps/turmalina/bases

# Integração com AI Gateway e Provedores LLM
AI_GATEWAY_URL=http://ai-gateway:8000
ECD_SERVER_URL=http://server:8080
GROQ_API_KEY=gsk_placeholder_informe_sua_chave_aqui
